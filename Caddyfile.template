__DOMAIN__ {
	encode gzip
	basic_auth {
		__USER__ __HASH__
	}
	reverse_proxy app:8000 {
		# send streamed AI answers to the browser right away
		flush_interval -1
	}
}

# Inside Docker only: the Cloudflare tunnel (deploy/tunnel.sh) comes in here.
http://:8081 {
	encode gzip
	basic_auth {
		__USER__ __HASH__
	}
	reverse_proxy app:8000 {
		flush_interval -1
	}
}
